#!/usr/bin/env python

"""
usage: %prog files [options] [[url|nick] table]
   -u, --url = URL: an url to open (eg: postgres://user:pass@host/dbname)
   -n, --nick = nick: a nick in ~.sqledit
   -t, --table = table: open table 'table'
   -m, --mask: open a SqlMask (default is SqlTable)
   -T, --sqltable: open a SqlTable
   -d, --dev: open in 'dev' mode
   -D, --debug: print debug
   -g, --gtk-debug: use LogTheMethods
"""
import sys, re, datetime, os
import os
from ConfigParser import ConfigParser

Dir = os.path.abspath(os.path.dirname(__file__))
sys.path.append(os.path.join(Dir, '../../'))
import dbg
import layout
import sqlalchemy as sa
import sqlkit as sk
import layout.misc
import gtk
import misc.optionparse as optionparse


class MissingNickDefinition(Exception): pass

class choice(object):
    def __init__(self, engine=None):
        lay = """ {O tb=gtk-quit tb=gtk-refresh}
                   TVS=tree"""
        self.tables = {}
        self.engine = engine
        self.l = layout.Layout(lay, opts='-')
        self.w = self.l.show()
        self.tv = self.w['TV=tree']
        cols = ['table', 'def', 'pkey', 'fkey']
        self.stv = layout.misc.EasyTreeView(cols, tv=self.tv)
        self.model = self.tv.get_model()
        #self.configure_treeview(self.tv)
        self.tv.connect('button-press-event', self.popup_col_menu)
        self.l.connect(
            ('tb=gtk-quit', 'clicked', gtk.main_quit),
            ('tb=gtk-refresh', 'clicked', self.reload),
            )
        self.fill_model()

    def reload(self, *args):
        dbg.write('reloading sqlkit')
        print reload(sk)
        #reload(sk.sqlwidget)
        print reload(sk.table.table)
        #reload(sk.mask.mask)
        
    def popup_col_menu(self, wdg, ev ):
        try:
            self.w['M=popup'].destroy()
        except:
            pass
        iter = self.model.get_iter(
            wdg.get_path_at_pos(int(ev.x),int(ev.y))[0])
        table = self.model.get_value(iter,0)
        
        #table = self.model.get_value(self.model.get_iter(path), 0)

        
        menu = self.w['M=popup'] = gtk.Menu()

        ## add to filter
        item = gtk.MenuItem(label="mask" )
        item.connect('activate', self.activate_cb, ('mask', table ))
        menu.append(item)

        ## add to filter
        item = gtk.MenuItem(label="table" )
        item.connect('activate', self.activate_cb, ('table', table ))
        menu.append(item)

        menu.show_all()
        menu.popup(None, None, None, ev.button, ev.time)

    def activate_cb(self, wdg, data):
        #dbg.write()
        mode, table = data
        opts ={'table' : table,
           'dev' : dev,
           'single' : False,
           'nick' : table
           }
        if mode == 'mask':
            sk.SqlMask(**opts)
        else:
            sk.table.table.SqlTable(**opts)
            

    def fill_model(self):
        tables = sk.inspect.list_tables(eng=engine)
        tables.sort()
        for table in tables:
            if table.startswith('pg_'):
                continue
            iter = self.model.append(None)
            self.model.set(iter, 0, table)
            tbl = sa.Table(table, self.engine, autoload=True)
            self.tables[table] = tbl
            pks = []
            for pk in tbl.primary_key:
                pks += [pk.name]
            self.model.set(iter, 2, ",".join(pks))
            
            for c in tbl.c:
                col = self.model.append(iter)
                self.model.set(col, 0, c.name )
                self.model.set(col, 1, c.type.get_col_spec())
                if c.primary_key:
                    self.model.set(col, 2, 'X' )
                if c.foreign_key:
                    self.model.set(col, 3, repr(c.foreign_key) )
                

def read_conf():
    global option
    
    dbconf='.sqleditdb'
    dbconf = os.path.join(os.getenv('HOME'), dbconf)
    if os.path.exists(dbconf):
        c = ConfigParser()
        c.read(dbconf)
        for tup in c.items(option.nick):
            key, val = tup
            if getattr(option, key) is None:
                setattr(option, key, val)
    else:
        raise MissingNickDefinition
        

def get_engine(): 
    global options
    
    sa.global_connect(option.url)
    return sa.default_metadata.engine
   
###### Program

#table_name = None

option, args = optionparse.parse(__doc__)
if not args and not option: optionparse.exit()

if option.gtk_debug:
    dbg.ShowLogs(show=True)

if args:
    if re.search('://', args[0]):
        option.url = args[0]
    else:
        option.nick = args[0]
    
if len(args) >1:
    option.table = args[1]
    
if option.debug:
    dbg.debug(True)

if option.nick:
    read_conf()


sa.global_connect(option.url)
engine = sa.default_metadata.engine


if option.table:
    opts ={'table' : option.table,
           'engine' : engine,
           'dev' : option.dev,
           'single' : True,
           'nick' : option.table
           }
    if option.mask:
        sk.SqlMask(**opts)
    else:
        sk.table.table.SqlTable(**opts)
else:
    C = choice(engine=engine)    

gtk.main()


