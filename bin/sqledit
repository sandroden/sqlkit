#!/usr/bin/env python

"""
usage: %prog files [options] [[url|nick] table]
   -u, --url = URL: an url to open (eg postgres://user:pass@host/dbname)
   -n, --nick = nick: a nick in ~/.sqleditdb
   -t, --table = table: open table 'table'
   -m, --mask: open a SqlMask (default is SqlTable)
   -T, --sqltable: open a SqlTable (default when -t is used)
   -d, --dev: open in 'dev' mode
   -D, --debug: print debug
   -g, --gtk-debug: use LogTheMethods
   -S, --sql=statement: execute statement (requires -t)
   -a, --all-tables: read all table on startup (very slow)
   -f, --field_list=fields: comma (or space) separated field list 
   -o, --order_by=fields: comma separated field list
"""
import sys, re, datetime
import os
import user
from ConfigParser import ConfigParser, NoSectionError
import pdb

#sys.path.insert(0,'/usr/src/sqlalchemy/lib/')
Dir = os.path.abspath(os.path.dirname(__file__))
sys.path.insert(0, os.path.join(Dir, '../'))
import dbg
import layout
import sqlalchemy as sa
from sqlalchemy.orm import sessionmaker
from sqlalchemy.exceptions import OperationalError
import gtk
from dry import optionparse

class MissingNickDefinition(Exception): pass

class choice(object):
    def __init__(self, engine=None):
        lay = """ {O tb=gtk-quit tb=gtk-refresh }
                   {- b=filter_tables e=filter}
                   TVS=tree"""
        self.tables = {}
#        self.engine = engine
        self.l = layout.Layout(lay, opts='-')
        self.l.pack(
            ## fill is just to avoid default that is expand
            ('T.0',             'y-options', 'fill'),
            ('b=filter_tables', 'x-options', 'fill'),
            )
        self.w = self.l.show(file='/tmp/sqledit.glade')
        self.tv = self.w['TV=tree']
        cols = ['table', 'def', 'pkey', 'fkey']
        self.stv = layout.misc.EasyTreeView(cols, tv=self.tv)
        self.model = self.tv.get_model()
        #self.configure_treeview(self.tv)
        self.tv.connect('button-press-event', self.popup_col_menu)
        self.l.connect(
            ('tb=gtk-quit', 'clicked', gtk.main_quit),
            ('tb=gtk-refresh', 'clicked', self.reload),
            ('b=filter_tables', 'clicked', self.fill_model),
            ('e=filter', 'activate', self.fill_model),
            )
        self.fill_model()

    def reload(self, *args):
        dbg.write('reloading sqlkit')
        print reload(sqlkit)
        #reload(sqlkit.sqlwidget)
        print reload(sqlkit.table.table)
        #reload(sqlkit.mask.mask)
        
    def popup_col_menu(self, wdg, ev ):
        try:
            self.w['M=popup'].destroy()
        except:
            pass
        iter = self.model.get_iter(
            wdg.get_path_at_pos(int(ev.x),int(ev.y))[0])
        table = self.model.get_value(iter,0)
        
        #table = self.model.get_value(self.model.get_iter(path), 0)

        
        menu = self.w['M=popup'] = gtk.Menu()

        ## add to filter
        item = gtk.MenuItem(label="mask" )
        item.connect('activate', self.activate_cb, ('mask', table ))
        menu.append(item)

        ## add to filter
        item = gtk.MenuItem(label="table" )
        item.connect('activate', self.activate_cb, ('table', table ))
        menu.append(item)

        ## add to filter
        item = gtk.MenuItem(label="table reflection" )
        item.connect('activate', self.get_table_info_in_model, (table, iter ))
        menu.append(item)

        menu.show_all()
        menu.popup(None, None, None, ev.button, ev.time)

    def activate_cb(self, wdg, data):
        #dbg.write()
        mode, table = data
        options ={'table' : table,
               'dev' : opts.dev,
               'single' : False,
               'nick' : "%s_%s" % (table, mode),
               'dbproxy' : db,
           }
        if mode == 'mask':
            try:
                SqlMask(**options)
            except sqlkit.completion.MissingDescriptorField:
                pass
        else:
            try:
                SqlTable(**options)
            except sqlkit.completion.MissingDescriptorField:
                pass
            
    def skip_table(self, table):
        """ this is just for skipping, must return True"""
        
        if db.metadata.bind.name == 'postgres' and table.startswith('pg_'):
            return True
        if not re.search(TABLE_MATCH, table):
            return True

    def fill_model(self, *args):
        """called by button filter_table and filter entry"""
        global TABLE_MATCH
        self.model.clear()
        TABLE_MATCH = self.w['e=filter'].get_text() or ".*"
        tables = db.metadata.bind.table_names()
        tables.sort()
        for table in tables:
            if self.skip_table(table):
                continue
            iter = self.model.append(None)
            self.model.set(iter, 0, table)
            if opts.all_tables:
                self.get_table_info_in_model(None, (table, iter))

    def get_table_info_in_model(self, junk, (table_name, iter)):
        #dbg.write(table_name, iter)
        tbl = sa.Table(table_name, db.metadata, autoload=True)
        self.tables[table_name] = tbl
        pks = []
        for pk in tbl.primary_key:
            pks += [pk.name]
        self.model.set(iter, 2, ",".join(pks))
            
        for c in tbl.c:
            col = self.model.append(iter)
            self.model.set(col, 0, c.name )
            self.model.set(col, 1, c.type.get_col_spec())
            if c.primary_key:
                self.model.set(col, 2, 'X' )
            if c.foreign_keys:
                self.model.set(col, 3, repr(c.foreign_keys) )
                

def read_conf(nick):
    dbconf='.sqleditdb'
    dbconf = os.path.join(os.getenv('HOME'), dbconf)
    if os.path.exists(dbconf):
        c = ConfigParser()
        c.read(dbconf)
        for tup in c.items(nick):
            key, val = tup
            if getattr(opts, key, None) is None:
                setattr(opts, key, val)
    else:
        raise MissingNickDefinition
        

def open_sqlwidget(table, single):
    global opts
    options ={'table' : table,
              'dev' : opts.dev,
              'single' : single,
              'nick' : table,
              'dbproxy' : db,
              'sql' : opts.sql,
              'field_list' : opts.field_list,
              'order_by' : opts.order_by,
           }
    if opts.mask:
        try:
            SqlMask(**options)
        except sqlkit.completion.MissingDescriptorField:
            pass

    else:
        try:
            SqlTable(**options)
        except sqlkit.completion.MissingDescriptorField:
            pass
            

###### Program

#table_name = None

opts, args = optionparse.parse(__doc__)
#print opts

if not args and not opts: optionparse.exit()

if opts.gtk_debug:
    dbg.trace_class(ok='SqlTable|SqlMask|Completion')
    but = 'set_fkey_descr|(lookup|set|get)_value|[el]ne_cb|match_func' + \
       '|cell_default_cb|cell_bool_cb|_lookup_value|is_fkey'
    dbg.trace_function(exclude=but)
    dbg.debug(True)
    lgm = dbg.ShowLogs(show=True)

import sqlkit
from sqlkit import SqlTable, SqlMask
from sqlkit.db import proxy
import layout.misc

if args:
    if re.search('://', args[0]):
        opts.url = args[0]
    else:
        opts.nick = args[0]
    
if len(args) >1:
    opts.table = args[1]
    
if opts.debug:
    dbg.debug(True)

if opts.nick:
    try:
        read_conf(opts.nick)
    except NoSectionError:
        print "No nick named '%s'" % opts.nick
        sys.exit(1)


try:
    db = proxy.DbProxy(engine=opts.url)
except ImportError, e:
    print e.message
    if e.message == 'No module named MySQLdb':
        print "You need to install mysql driver (python-mysqldb under debian)"
    sys.exit(1)
    
session = db.get_session()

#engine = sa.create_engine(opts.url)
#metadata = sa.MetaData(bind=opts.url)
#session = sessionmaker(bind=engine,transactional=True)()
#sa.global_connect(opts.url)
#engine = sa.default_metadata.engine


try:
     if opts.table:
         tables = re.split('[ ,]+', opts.table)
         for t in tables:
             if len(tables) > 1:
                 single = False
             else:
                 single = True
             open_sqlwidget(t, single)
     else:
         C = choice(engine=session.bind)    

except OperationalError, e:
    if opts.debug:
        raise e
    else:
        print e.orig
        sys.exit(1)
     
try:
    gtk.main()
except KeyboardInterrupt:
    pass
