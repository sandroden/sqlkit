# -*- mode: makefile -*-
# this is meant for me (sandro) to create distribution and releases

# $pkg
.PHONY: install clean
DEB=$(shell cat debian/files |cut -f 1 -d " ")
#VER=$(shell head -n1 debian/files|cut -f 2 -d _)
VER=$(shell grep __version__ sqlkit/__init__.py|cut -f 2 -d = |tr -d " '")
PKG=$(shell echo $(shell pwd)| sed 's/.*\///')
DIR=/home/www/sandro/apt/download.argolinux.org/sqlkit
WWW=apt@www3:$(DIR)
TGZ=sqlkit_$(VER).tar.gz
PTGZ=sqledit-binary-$(VER).tar.gz
PYI=/misc/src/svn/pyinstaller-hg/

clean:
	find -name \*~ -exec rm {} \;
	find -name \*~ -exec rm {} \;
	find -name \#\*  -exec rm {} \;
	find -name .backups -exec rm -Rf {} \; || true
	rm -Rf ../build/*sqlkit*

source: mknew
	cd ../build/; dpkg-source -b sqlkit-$(VER)

orig:   source
	cd ../build/; mkdir sqlkit-$(VER).orig; cd sqlkit-$(VER).orig; tar --strip 1 -xzf ../sqlkit_$(VER).orig.tar.gz

diff:  
	diff -u  sqlkit-$(VER).orig/setup.py sqlkit-$(VER)> ../sqlkit/debian/patches/00_setup.diff
	diff -u  sqlkit-$(VER).orig/sqlkit/__init__.py sqlkit-$(VER)/sqlkit/ > ../sqlkit/debian/patches/01_locale.diff
	diff -u  sqlkit-$(VER).orig/MANIFEST.in sqlkit-$(VER) > ../sqlkit/debian/patches/03_manifest.diff
	diff -u  sqlkit-$(VER).orig/MANIFEST.in sqlkit-$(VER) > ../sqlkit/debian/patches/03_manifest.diff
	diff -u  sqlkit-$(VER).orig/demo/sql sqlkit-$(VER)/demo/sql/ > ../sqlkit/debian/patches/04_demo_in_tmp.diff
tgz:
	#hg archive -t tar ../sqlkit-$(VER).tar.gz
	#	hg archive -X debian -t tgz ../sqlkit-$(VER).tar.gz
	hg archive -X debian -t tgz ../sqlkit-$(VER).tar.gz
	tar xzf ../sqlkit-$(VER).tar.gz
	cp -a doc/.build/html sqlkit-$(VER)/doc/
	rm -Rf sqlkit-$(VER)/.hg*
	tar czf ../sqlkit-$(VER).tar.gz sqlkit-$(VER)
	rm -Rf sqlkit-$(VER)

mknew:  clean tgz
	mkdir -p ../build
	tar -C ../build -xzf ../sqlkit-$(VER).tar.gz
	mkdir ../build/sqlkit-$(VER)/debian 
	find debian  -maxdepth 1 -type f -exec cp {} ../build/sqlkit-$(VER)/debian \;
	cp -a debian/patches ../build/sqlkit-$(VER)/debian
	cp ../sqlkit-$(VER).tar.gz ../build/sqlkit_$(VER).orig.tar.gz

deb:    mknew
#	no signature!
	cd ../build/sqlkit-$(VER); dpkg-buildpackage -rfakeroot -us -uc | tee log	
#	find ../build -maxdepth 1  -type f -exec mv {} .. \;
	echo pkg=$(PKG)  deb=$(DEB)
#	hg status

debs:   mknew
	cd ../build/sqlkit_$(VER); dpkg-buildpackage -rfakeroot | tee log	
	echo pkg=$(PKG)  deb=$(DEB)
	hg status

content:  
	dpkg -c ../$(DEB)

lcheck: 
	find -newer ../$(DEB)

ver:
	head -n1 debian/changelog
	echo dch -v

upload: etch sarge

etch:
	upload-deb etch/main $(DEB) 

lenny:
	upload-deb lenny/sqlkit $(DEB) 

lenny-force:
	upload-deb -F lenny/sqlkit $(DEB) 

sarge:
	upload-deb sarge/main $(DEB) 

dpkg:
	su root "dpkg -i ../$(DEB)"

check:  lcheck
	find -newer uploaded

install:
	find -name \*~ -exec rm {} \;
	find -name \*~ -exec rm {} \;
	find -name \#\*  -exec rm {} \;
	find -name .\#\* -exec rm {} \;

rsync:
	ssh apt@www2 'cd $(DIR) && rm -f sqlkit-latest.tar.gz && mv *sqlkit* OLD' || true
	rsync --progress ../$(TGZ) $(WWW)/
	rsync --progress ../$(PTGZ) $(WWW)/
	for file in $(DEB); do rsync --progress ../$${file} $(WWW)/; done
	#rsync --progress ../$(DEB) $(WWW)/
	ssh apt@www2 'cd $(DIR) && ln -s $(TGZ) sqlkit-latest.tar.gz'
	rsync changelog $(WWW)/Changelog

rel:	tgz deb lenny mkinstaller rsync 

extract:
	#	 python setup.py extract_messages 
	pybabel extract -o sqlkit/locale/sqlkit.pot -c TIP bin sqlkit

update:
	python setup.py update_catalog
	virtaal sqlkit/locale/it/LC_MESSAGES/sqlkit.po
	python setup.py compile_catalog	

compile:
	python setup.py compile_catalog

mkinstaller:
	pyinstaller/make-installer $(PYI)/Build.py pyinstaller-sqledit.spec $(VER)
	tar -C pyinstaller -chzf ../sqledit-binary-$(VER).tar.gz sqledit-$(VER)
	echo ../sqledit-binary-$(VER).tar.gz
