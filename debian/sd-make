# -*- mode: makefile -*-
# this is meant for me (sandro) to create distribution and releases

# $pkg
.PHONY: install clean
DEB=$(shell cat debian/files |cut -f 1 -d " ")
#VER=$(shell head -n1 debian/files|cut -f 2 -d _)
VER=$(shell grep __version__ sqlkit/__init__.py|cut -f 2 -d = |tr -d " '")
PKG=$(shell echo $(shell pwd)| sed 's/.*\///')
DIR=/home/www/sandro/apt/download.argolinux.org/sqlkit
WWW=apt@www3:$(DIR)
TGZ=sqlkit-$(VER).tar.gz
PTGZ=sqledit-binary-$(VER).tar.gz
PYI=/misc/src/svn/pyinstaller-hg/

deb:    clean
	dpkg-buildpackage -rfakeroot -us -uc -b | tee log
	echo pkg=$(PKG)  deb=$(DEB)
	hg status

content:  
	dpkg -c ../$(DEB)

lcheck: 
	find -newer ../$(DEB)

ver:
	head -n1 debian/changelog
	echo dch -v

upload: etch sarge

etch:
	upload-deb etch/main $(DEB) 

lenny:
	upload-deb lenny/sqlkit $(DEB) 

sarge:
	upload-deb sarge/main $(DEB) 

dpkg:
	su root "dpkg -i ../$(DEB)"

check:  lcheck
	find -newer uploaded

install:
	find -name \*~ -exec rm {} \;
	find -name \*~ -exec rm {} \;
	find -name \#\*  -exec rm {} \;
	find -name .\#\* -exec rm {} \;
#	rm -Rf $(DESTDIR)
#	mkdir -p $(DESTDIR)/usr/share/doc/python-sqlkit
#	cp -a demo $(DESTDIR)/usr/share/doc/python-sqlkit
#	cp -a bin/sqledit $(DESTDIR)/usr/bin
#	cp -a doc/.build/html $(DESTDIR)/usr/share/doc/python-sqlkit/html
#	cp -a usr/* $(DESTDIR)/usr
#	find $(DESTDIR) -name .backups -exec rm -Rf {} \;

clean:
	find -name \*~ -exec rm {} \;
	find -name \*~ -exec rm {} \;
	find -name \#\*  -exec rm {} \;
	find -name .backups -exec rm -Rf {} \; || true

tgz:
	hg archive -t tgz ../sqlkit-$(VER).tar.gz

rsync:
	ssh apt@www2 'cd $(DIR) && rm -f sqlkit-latest.tar.gz && mv *sqlkit* OLD' || true
	rsync --progress ../$(TGZ) $(WWW)/
	rsync --progress ../$(PTGZ) $(WWW)/
	for file in $(DEB); do rsync --progress ../$${file} $(WWW)/; done
	#rsync --progress ../$(DEB) $(WWW)/
	ssh apt@www2 'cd $(DIR) && ln -s $(TGZ) sqlkit-latest.tar.gz'
	rsync changelog $(WWW)/Changelog

rel:	deb tgz lenny mkinstaller rsync 

extract:
	#	 python setup.py extract_messages 
	pybabel extract -o sqlkit/locale/sqlkit.pot -c TIP bin sqlkit

update:
	python setup.py update_catalog
	virtaal sqlkit/locale/it/LC_MESSAGES/sqlkit.po
	python setup.py compile_catalog	

compile:
	python setup.py compile_catalog

mkinstaller:
	pyinstaller/make-installer $(PYI)/Build.py pyinstaller-sqledit.spec $(VER)
	tar -C pyinstaller -chzf ../sqledit-binary-$(VER).tar.gz sqledit-$(VER)
	echo ../sqledit-binary-$(VER).tar.gz
